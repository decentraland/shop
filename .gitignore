# Dependencies
node_modules/

# Builds
dist/
build/
*.tsbuildinfo
# Compiled from vite.config.ts by `tsc -b`. NOT harmless: vite resolves vite.config.js BEFORE
# vite.config.ts, so a compiled sibling silently shadows the real config and every edit to it becomes a
# no-op. tsconfig.node.json now emits to node_modules/.tmp instead; these entries stay for old checkouts.
app/vite.config.js
app/vite.config.d.ts

# Tests / coverage
coverage/

# Env — commit only *.env.example (real/local configs are ignored, incl. dev secrets)
.env
.env.local
.env.*.local
.env.default

# Tool run output
tools/*/out/

# Editor / OS
.DS_Store
*.log
npm-debug.log*
.idea/
# Ignore everything in .vscode/ EXCEPT the shared settings.json (keeps the editor's ESLint working
# dir in sync with `npm run lint`). Ignore the contents (not the dir itself) so the negation can
# re-include one file — git won't descend into a fully-excluded directory.
.vscode/*
!.vscode/settings.json

# Internal design / vision / analysis docs — never public.
design/
/VISION.md
/ROADMAP.md
